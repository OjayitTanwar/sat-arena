# ─── SAT Arena configuration ────────────────────────────────────────────────

# Port the server runs on
PORT=3000

# Secret used to sign nothing much (sessions are DB-backed tokens), but good hygiene
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Optional: GOOGLE SIGN-IN (OAuth 2.0) ───────────────────────────────────
# Enables the "Continue with Google" button on the login page.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (type: Web application)
# 3. Add an Authorized redirect URI:
#      http://localhost:3000/api/auth/google/callback
# 4. Copy the Client ID and Client Secret below.
# Without these, the app runs fine — the Google button just shows a notice.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: your app's public URL, used to build the OAuth redirect_uri.
# Set this when deploying behind a proxy (Heroku/Render/nginx) — otherwise
# localhost is assumed.
# APP_URL=https://your-app.example.com

# ─── Optional: FREE AI TUTOR ────────────────────────────────────────────────
# The app works 100% without these keys — the built-in tutor + question
# generator handle everything. Add ONE of these free-tier keys to supercharge
# the tutor chat with a real LLM.

# Google Gemini (free tier) — get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# OR Groq (free tier) — get a key at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

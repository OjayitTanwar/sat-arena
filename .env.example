# ─────────────────────────────────────────────────────────────────────────────
# SAT Arena — environment variables
# Copy this file to .env (it is gitignored) and fill in what you need.
#   cp .env.example .env
# The app runs with zero configuration; every key here is optional.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin account (seeded on every server start) ─────────────────────────────
# ADMIN_EMAIL defaults to the original admin email; ADMIN_USERNAME to "admin".
# ADMIN_PASSWORD has NO default. While set, the seed force-sets the admin's
# password to this value on every start (guaranteed admin access). When unset,
# an existing admin's password is never touched, and a brand-new admin gets a
# random password printed once in the server log. Never ship a known password
# in source — put it here instead.
# ADMIN_EMAIL=you@example.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Persistence ──────────────────────────────────────────────────────────────
# Without these the app uses the local file data/satarena.db (dev).
# With them it uses Turso (free persistent SQLite over HTTPS) — required on
# hosts like Render that wipe the local filesystem on restart.
#   turso db create sat-arena && turso db show sat-arena --url
#   turso db tokens create sat-arena
# TURSO_URL=libsql://sat-arena-<org>.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# ── Public URL (Google OAuth redirect + tunnel watchdog) ─────────────────────
# APP_URL=https://sat-arena.onrender.com
# TUNNEL_LOG=/tmp/tunnel.log

# ── Auth: Google OAuth 2.0 (optional) ────────────────────────────────────────
# Create credentials at https://console.cloud.google.com (OAuth client, Web app)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx

# ── AI tutor (optional — works with a built-in engine without keys) ─────────
# GEMINI_API_KEY=AIza...          # free tier: https://aistudio.google.com/apikey
# GROQ_API_KEY=gsk_...            # free tier: https://console.groq.com/keys
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Email (OTP signup / password reset) ──────────────────────────────────────
# Prefer SMTP (works without a verified domain): Gmail app password, SMTP2GO,
# Brevo, Zoho… Any provider. Resend is the fallback (needs a verified domain).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                    # 465 for SSL, 587 for STARTTLS
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=0                    # 1 for port 465
# RESEND_API_KEY=re_...
# EMAIL_FROM=SAT Arena <onboarding@resend.dev>

# ── Monetization ─────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...    # enables gem-pack + premium checkout
# PREMIUM_PRICE_CENTS=999          # premium subscription price in cents

# ── Ads (free-tier slots) ────────────────────────────────────────────────────
# ADS_ENABLED=0                    # 1 to show ads to free users
# ADS_CODE=<custom ad snippet>     # custom network
# ADS_NETWORK=custom               # 'custom' | 'adsense'
# ADSENSE_CLIENT=ca-pub-...        # Google AdSense auto-ads publisher id

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=3000

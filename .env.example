# ── SAT Arena environment variables ────────────────────────────────────────
# Copy to .env locally, or set these in Render's dashboard (Secret Files).
# Everything except PORT can also be set live from the admin panel.

# Web server
PORT=3000

# Public base URL (used for OAuth + Stripe redirects)
APP_URL=https://sat-arena.onrender.com

# Google OAuth (admin panel can set these instead)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI tutor keys (server-wide; admin panel can set these instead)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Email — powers OTP signup + password reset emails. Two free options:
#   • SMTP: fastest to go live, no domain needed. Gmail app password works
#     (~500/day). Also SMTP2GO, Brevo, Zoho… (set from the admin panel too)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
#   • Resend API: needs a verified sending domain to reach external recipients
RESEND_API_KEY=
EMAIL_FROM=SAT Arena <onboarding@resend.dev>
# Without any provider the app runs in dev mode and shows codes on screen.

# Ads — paste your ad network snippet (Adsterra etc.) OR set an AdSense
# client id (ca-pub-…, requires an approved AdSense account + custom domain)
ADS_ENABLED=
ADS_CODE=
ADSENSE_CLIENT=

# Premium subscription pricing (USD cents; 999 = $9.99/month)
PREMIUM_PRICE_CENTS=999

# Payments — Stripe for premium subscriptions + gem packs
# (can be set from the admin panel too; sk_test_… for testing)
STRIPE_SECRET_KEY=

# Turso (persistent database for Render) — set by deploy.sh
TURSO_URL=
TURSO_AUTH_TOKEN=
